# Docker build
# UBUNTU_MIRROR=mirror.arizona.edu
VIRTUAL_ENV=/home/comses/virtualenvs/comses.venv
UBUNTU_MIRROR=archive.ubuntu.com
# set PATH defaults for cron execution
PATH="/usr/lib/postgresql/16/bin:${VIRTUAL_ENV}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# app settings
RELEASE_VERSION=
EXPIRED_JOB_DAYS_THRESHOLD=180
EXPIRED_EVENT_DAYS_THRESHOLD=2

# Per-archive resource budgets (bytes, member count, path depth, seconds).
ARCHIVE_MAX_INPUT_BYTES=104857600
ARCHIVE_MAX_TOTAL_BYTES=2147483648
ARCHIVE_MAX_FILE_BYTES=104857600
ARCHIVE_MAX_MEMBERS=10000
ARCHIVE_MAX_PATH_DEPTH=32
ARCHIVE_MAX_SECONDS=45

# Borg retention: archive counts, -1 unlimited, 0 disables a tier.
# Pruning remains explicit operator maintenance; these values do not schedule it.
BORG_KEEP_DAILY=14
BORG_KEEP_WEEKLY=8
BORG_KEEP_MONTHLY=12
BORG_KEEP_YEARLY=-1

# database
DB_NAME=comsesnet
DB_USER=comsesnet
DB_HOST=db
DB_PORT=5432
CLEAN_DATABASE="false"  # allowed values: "true" or "false"

# discourse
DISCOURSE_BASE_URL=
DISCOURSE_API_USERNAME=

# comses librarian sso
LIBRARIAN_BASE_URL=

# Elasticsearch
ES_VERSION=9.5.5

# email
EMAIL_SUBJECT_PREFIX="[CoMSES Net]"
MAILGUN_SENDER_DOMAIN=

# hcaptcha
HCAPTCHA_SITEKEY=

# spam detection is configured in the Wagtail admin. API keys go in the voyager_ai_api_key and
# cloudflare_ai_api_token secrets
CLOUDFLARE_ACCOUNT_ID=

# sentry logging
SENTRY_DSN=

# socialauth
GITHUB_CLIENT_ID=
ORCID_CLIENT_ID=

# datacite api settings
DATACITE_API_USERNAME=
DATACITE_DRY_RUN="true" # allowed values: "true" or "false"

# youtube api settings
YOUTUBE_CHANNEL_ID=

# github integration app
GITHUB_INTEGRATION_APP_ID=
GITHUB_INTEGRATION_APP_NAME=
GITHUB_INTEGRATION_APP_INSTALLATION_ID=
GITHUB_MODEL_LIBRARY_ORG_NAME=

# test
TEST_USER_ID=10000000
TEST_USERNAME=__test_user__
TEST_BASIC_AUTH_PASSWORD=
