#!/usr/bin/env bash
set -euo pipefail

APP_ROOT=${COMSES_APP_ROOT:-$(pwd -P)}
SHARED_ROOT=${COMSES_SHARED_ROOT:-$APP_ROOT/docker/shared}
POSTGRES_ROOT=${COMSES_POSTGRES_ROOT:-$APP_ROOT/docker/pgdata}
LOG_ROOT=${COMSES_LOG_ROOT:-$SHARED_ROOT/logs}
BACKUPS_ROOT=${COMSES_BACKUPS_ROOT:-/srv/backups/comses}
SECRETS_ROOT=${COMSES_SECRETS_ROOT:-$APP_ROOT/docker/secrets}
DEPLOY_ENVIRONMENT=${DEPLOY_ENVIRONMENT:-dev}
DEPLOY_UID=${DEPLOY_UID:-1000}
DEPLOY_GID=${DEPLOY_GID:-1000}
APP_UID=${APP_UID:-0}
APP_GID=${APP_GID:-0}
POSTGRES_UID=${POSTGRES_UID:-999}
POSTGRES_GID=${POSTGRES_GID:-999}
REDIS_UID=${REDIS_UID:-999}
REDIS_GID=${REDIS_GID:-1000}
ELASTICSEARCH_UID=${ELASTICSEARCH_UID:-1000}
ELASTICSEARCH_GID=${ELASTICSEARCH_GID:-0}
NGINX_UID=${NGINX_UID:-101}
NGINX_GID=${NGINX_GID:-101}

# Pinned host paths. Overridable so storage tests can exercise the same
# staging/prod validation logic against a disposable fixture tree.
EXPECTED_APP_ROOT=${COMSES_EXPECTED_APP_ROOT:-/srv/apps/comses}
EXPECTED_SHARED_ROOT=${COMSES_EXPECTED_SHARED_ROOT:-$EXPECTED_APP_ROOT/docker/shared}
EXPECTED_POSTGRES_ROOT=${COMSES_EXPECTED_POSTGRES_ROOT:-$EXPECTED_APP_ROOT/docker/pgdata}
EXPECTED_LOG_ROOT=${COMSES_EXPECTED_LOG_ROOT:-/srv/logs/comses}
EXPECTED_BACKUPS_ROOT=${COMSES_EXPECTED_BACKUPS_ROOT:-/srv/backups/comses}
EXPECTED_SECRETS_ROOT=${COMSES_EXPECTED_SECRETS_ROOT:-$EXPECTED_APP_ROOT/docker/secrets}
SRV_ROOT=${COMSES_SRV_ROOT:-/srv}

# Infrastructure collaborative group for the canonical logs/backups bind
# roots (typically "operators"); resolved lazily so a missing group on a
# workstation or test host does not abort the script.
OPERATORS_GID=${COMSES_OPERATORS_GID:-}
if [ -z "$OPERATORS_GID" ]; then
    OPERATORS_GID=$(getent group operators 2>/dev/null | cut -d: -f3) || true
fi

die() {
    echo "storage-preflight: $*" >&2
    exit 1
}

contains_data() {
    local path=$1 first_entry
    [ -d "$path" ] || return 1
    if ! first_entry=$(find -P "$path" -mindepth 1 -print -quit 2>/dev/null); then
        die "cannot inspect $path; verify it as root before selecting the authoritative PostgreSQL cluster"
    fi
    [ -n "$first_entry" ]
}

require_owner_mode() {
    local path=$1 expected=$2 actual
    actual=$(stat -c '%u:%g %a' "$path")
    [ "$actual" = "$expected" ] || die "$path has owner/mode $actual; expected $expected"
}

require_not_symlinked() {
    local path=$1
    [ -e "$path" ] || die "required path is missing: $path; run deploy/scripts/prepare-host-storage as root"
    [ ! -L "$path" ] || die "deployed path must not be a symlink: $path"
    [ "$(realpath -e "$path")" = "$path" ] || die "deployed path resolves through a symlink: $path"
}

require_provisioned_mount() {
    local mount_target
    mount_target=$(findmnt -n -o TARGET --mountpoint "$SRV_ROOT") || die "$SRV_ROOT is not mounted; infrastructure must mount it before deployment"
    [ "$mount_target" = "$SRV_ROOT" ] || die "$SRV_ROOT is not an exact mountpoint"
}

require_non_root_storage() {
    local path=$1 mount_target
    mount_target=$(findmnt -n -o TARGET -T "$path") || die "cannot identify the filesystem containing $path"
    [ "$mount_target" != / ] || die "$path is on the root filesystem, not provisioned /srv storage"
}

# Confirms a bind-mounted collaborative path (e.g. /srv/logs/comses) and its
# corresponding bind-mounted checkout path (e.g. docker/shared/logs) are the
# same underlying filesystem object, per the infrastructure bind-mount
# contract in docs/agents/storage-layout.md.
require_same_object() {
    local bind_target=$1 checkout_source=$2 target_id source_id
    [ -d "$checkout_source" ] || die "$checkout_source is missing; it must be the bind-mounted checkout path for $bind_target"
    target_id=$(stat -c '%d:%i' "$bind_target") || die "cannot stat $bind_target"
    source_id=$(stat -c '%d:%i' "$checkout_source") || die "cannot stat $checkout_source"
    [ "$target_id" = "$source_id" ] || die "$bind_target does not resolve to the same filesystem object as $checkout_source; verify the infrastructure bind mount"
}

# Validates an infrastructure-owned collaborative root (logs, backups)
# without requiring one exact numeric owner/group/mode, since infrastructure
# enforces its own policy (typically debian:operators 2775) on these paths.
# Accepts setgid and operators-group collaboration; still fails closed on
# world-writable or unexpectedly broad group access, and confirms the
# deployment/service user has effective access.
validate_collaborative_root() {
    local path=$1 mode perm group_perm other_perm gid probe
    require_not_symlinked "$path"
    [ -d "$path" ] || die "$path must be a directory"
    require_non_root_storage "$path"

    mode=$(stat -c '%a' "$path")
    perm=${mode: -3}
    group_perm=${perm:1:1}
    other_perm=${perm:2:1}

    (( 8#$other_perm & 2 )) && die "$path must not be world-writable (mode $mode)"

    if (( 8#$group_perm & 2 )); then
        gid=$(stat -c '%g' "$path")
        if [ "$gid" != "$APP_GID" ] && [ "$gid" != "$DEPLOY_GID" ] &&
            { [ -z "$OPERATORS_GID" ] || [ "$gid" != "$OPERATORS_GID" ]; }; then
            die "$path is group-writable by unexpected group $gid; expected the app, deploy, or operators group"
        fi
    fi

    probe="$path/.storage-preflight-probe.$$"
    if ! ( : > "$probe" ) 2>/dev/null; then
        die "$path is not writable by the deployment/service user; required collaborative access is not effective"
    fi
    rm -f "$probe"
}

EXPOSED_POSTGRES_ROOT="$SHARED_ROOT/postgres"
if [ "${COMSES_POSTGRES_AUTHORITY:-}" != isolated ] && contains_data "$EXPOSED_POSTGRES_ROOT"; then
    if contains_data "$POSTGRES_ROOT"; then
        die "both $POSTGRES_ROOT and $EXPOSED_POSTGRES_ROOT contain PostgreSQL data; identify the authoritative cluster before selecting COMSES_POSTGRES_AUTHORITY=isolated"
    fi
    die "$EXPOSED_POSTGRES_ROOT contains PostgreSQL data; stop services and move it to isolated storage at $POSTGRES_ROOT according to docs/agents/postgresql-upgrade-runbook.md"
fi

if [[ "$DEPLOY_ENVIRONMENT" != staging && "$DEPLOY_ENVIRONMENT" != prod ]]; then
    df -P "$APP_ROOT"
    echo "Storage preflight passed for $DEPLOY_ENVIRONMENT; build will create repository-local writable paths."
    exit 0
fi

if [[ "$DEPLOY_ENVIRONMENT" == staging || "$DEPLOY_ENVIRONMENT" == prod ]]; then
    [ "$APP_ROOT" = "$EXPECTED_APP_ROOT" ] || die "COMSES_APP_ROOT must be $EXPECTED_APP_ROOT for $DEPLOY_ENVIRONMENT"
    [ "$(pwd -P)" = "$APP_ROOT" ] || die "run from the canonical checkout $APP_ROOT (symlinks are not accepted)"
    [ "$SHARED_ROOT" = "$EXPECTED_SHARED_ROOT" ] || die "COMSES_SHARED_ROOT must be $EXPECTED_SHARED_ROOT"
    [ "$POSTGRES_ROOT" = "$EXPECTED_POSTGRES_ROOT" ] || die "COMSES_POSTGRES_ROOT must be $EXPECTED_POSTGRES_ROOT"
    [ "$LOG_ROOT" = "$EXPECTED_LOG_ROOT" ] || die "COMSES_LOG_ROOT must be $EXPECTED_LOG_ROOT"
    [ "$BACKUPS_ROOT" = "$EXPECTED_BACKUPS_ROOT" ] || die "COMSES_BACKUPS_ROOT must be $EXPECTED_BACKUPS_ROOT"
    [ "$SECRETS_ROOT" = "$EXPECTED_SECRETS_ROOT" ] || die "COMSES_SECRETS_ROOT must be $EXPECTED_SECRETS_ROOT"

    for path in "$APP_ROOT" "$SHARED_ROOT" "$POSTGRES_ROOT" "$SECRETS_ROOT"; do
        require_not_symlinked "$path"
    done
    for path in \
        "$SHARED_ROOT/backups/repo" \
        "$SHARED_ROOT/elasticsearch/v9/primary" \
        "$SHARED_ROOT/elasticsearch/v9/secondary" \
        "$SHARED_ROOT/library" \
        "$SHARED_ROOT/media" \
        "$POSTGRES_ROOT" \
        "$SHARED_ROOT/redis" \
        "$SHARED_ROOT/static" \
        "$SHARED_ROOT/tls/well-known" \
        "$LOG_ROOT/nginx"; do
        [ -d "$path" ] || die "required managed directory is missing: $path"
        [ ! -L "$path" ] || die "managed directory must not be a symlink: $path"
        [ "$(realpath -e "$path")" = "$path" ] || die "managed directory resolves through a symlink: $path"
    done
    require_provisioned_mount
    require_non_root_storage "$APP_ROOT"
    if [ -d "$APP_ROOT/build/secrets" ] && [ "${COMSES_STORAGE_AUTHORITY:-}" != new ]; then
        die "legacy build/secrets still exists; verify the in-place secret copy and set COMSES_STORAGE_AUTHORITY=new before deployment"
    fi

    # Infrastructure-owned collaborative roots: validated for security and
    # functionality rather than one exact owner/group/mode. See
    # docs/agents/storage-layout.md for the ownership boundary.
    validate_collaborative_root "$LOG_ROOT"
    validate_collaborative_root "$BACKUPS_ROOT"
    require_same_object "$LOG_ROOT" "$SHARED_ROOT/logs"
    require_same_object "$BACKUPS_ROOT" "$SHARED_ROOT/backups"

    # Application- and service-owned private paths: exact ownership and mode
    # because pinned container image UIDs/GIDs require them.
    require_owner_mode "$SHARED_ROOT" "$APP_UID:$APP_GID 755"
    require_owner_mode "$POSTGRES_ROOT" "$POSTGRES_UID:$POSTGRES_GID 700"
    require_owner_mode "$SHARED_ROOT/redis" "$REDIS_UID:$REDIS_GID 750"
    require_owner_mode "$SHARED_ROOT/elasticsearch/v9/primary" "$ELASTICSEARCH_UID:$ELASTICSEARCH_GID 750"
    require_owner_mode "$SHARED_ROOT/elasticsearch/v9/secondary" "$ELASTICSEARCH_UID:$ELASTICSEARCH_GID 750"
    require_owner_mode "$LOG_ROOT/nginx" "$NGINX_UID:$NGINX_GID 750"
    require_owner_mode "$SECRETS_ROOT" "$DEPLOY_UID:$DEPLOY_GID 700"
fi

for path in "$SHARED_ROOT" "$POSTGRES_ROOT" "$LOG_ROOT" "$SECRETS_ROOT"; do
    [ -d "$path" ] || die "required directory is missing: $path"
done
[ -w "$SECRETS_ROOT" ] || die "secret directory is not writable by the deployment user: $SECRETS_ROOT"

df -P "$SHARED_ROOT" "$LOG_ROOT"
echo "Storage preflight passed for $DEPLOY_ENVIRONMENT."
